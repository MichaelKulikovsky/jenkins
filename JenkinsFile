pipeline {

   agent any

   stages {

      stage('Checkout') {
        steps {
           echo "מושכים את הקוד מהמאגר"
           checkout scm
        }
      }

      stage('Install') {
        steps {
           echo "מתקינים תלויות"
           sh "npm ci"
        }
      }

      stage('Test') {
        steps {
           echo "מריצים בדיקות אם יש לנו ברכה ריקה זה ייכשל כאן"
           sh "npm test"
        }
      }

      stage('Build image') {
        steps {
           echo "בונים Docker Image"
           sh "docker build -t jenkins:${BUILD_NUMBER} -t jenkins:latest ."
        }
      }

      stage('Deploy') {
            steps {
                echo 'מריצים את הגרסה החדשה על פורט 3000'
                //  הסרת הקונטיינר הישן אם הוא קיים
                sh 'docker rm -f app-live || true'

                //  הרצת השרות החדש עם שם קבוע
                sh "docker run -d --name app-live -p 3000:3000 jenkins:${BUILD_NUMBER}"
            }
      }

   }

   post {
       success { echo "תהליך ה פייפלין עבר בהצלחה" }
       failure { echo "משהו נכשל" }
    }
}